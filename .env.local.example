# Copy this file to .env.local and keep the copy on this machine only.
# .env.local is ignored by Git. Never put a real key in this example file.

TRADING_V2_MODEL_ENABLED=true
TRADING_V2_MODEL_PROVIDER=deepseek
TRADING_V2_MODEL_NAME=deepseek-chat
TRADING_V2_MODEL_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=replace-with-your-local-key

# Optional decision settings
TRADING_V2_DECISION_ENABLED=true
TRADING_V2_DECISION_MIN_CONFIDENCE=0.65
